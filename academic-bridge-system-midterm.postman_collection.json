          "raw": "{\n    \"mentor\": {\n        \"id\": \"895aa70a-940c-48c1-a488-7ef4e4f6e76f\"\n    },\n    \"student\": {\n        \"id\": \"6b009145-59ec-4454-8aa0-feeb0156e66b\"\n    },\n    \"sessionDate\": \"2026-12-22\",\n    \"status\": \"HELD\",\n    \"topic\": \"Networking basics\"\n}",
